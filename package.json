{
	"name": "batch-export",
	"version": "0.1.2",
	"description": "Obsidian desktop plugin: export a folder of notes to a single PDF.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"clean": "node -e \"['main.js', 'main.js.map'].forEach(f => { try { fs.unlinkSync(f); } catch {} })\""
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"pdf",
		"export"
	],
	"author": "ding",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^22.10.2",
		"esbuild": "^0.24.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.72.1",
		"vitest": "^2.1.8"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dingzy53/obsidian-batch-export.git"
	}
}
