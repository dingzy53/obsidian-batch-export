{
	"name": "batch-export",
	"version": "0.2.0",
	"description": "Obsidian desktop plugin: export a folder of notes to a single PDF.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"clean": "node -e \"['main.js', 'main.js.map'].forEach(f => { try { fs.unlinkSync(f); } catch {} })\"",
		"test:unit": "vitest run",
		"check:mobile": "node scripts/check-mobile-compat.mjs",
		"test:e2e": "wdio run ./wdio.conf.mts",
		"test:e2e:fast": "OBSIDIAN_VERSIONS=latest/latest OBSIDIAN_E2E_TARGET=desktop wdio run ./wdio.conf.mts"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"pdf",
		"export"
	],
	"author": "Ding Zheng Yuan",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/mocha": "^10.0.10",
		"@types/node": "^22.10.2",
		"@wdio/cli": "^9.33.1",
		"@wdio/globals": "^9.31.3",
		"@wdio/local-runner": "^9.33.1",
		"@wdio/mocha-framework": "^9.33.1",
		"@wdio/spec-reporter": "^9.33.1",
		"esbuild": "^0.24.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"mocha": "^10.8.2",
		"obsidian": "^1.13.1",
		"tslib": "^2.8.1",
		"tsx": "^4.23.15",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.72.1",
		"vitest": "^2.1.8",
		"wdio-obsidian-reporter": "^3.5.0",
		"wdio-obsidian-service": "^3.5.0"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dingzy53/obsidian-batch-export.git"
	}
}
